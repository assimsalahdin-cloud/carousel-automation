{"name":"TikTok OAuth2 Proxy for n8n","nodes":[{"parameters":{"path":"tiktok-oauth-authorize-proxy","responseMode":"responseNode","options":{}},"id":"a1f0c0d1-1111-4b11-8111-111111111111","name":"Authorize Proxy","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-520,-120],"webhookId":"b1f0c0d1-1111-4b11-8111-111111111111"},{"parameters":{"respondWith":"redirect","redirectURL":"={{ 'https://www.tiktok.com/v2/auth/authorize/?client_key=' + encodeURIComponent($json.query.client_id || '') + '&response_type=code&scope=' + encodeURIComponent($json.query.scope || '') + '&redirect_uri=' + encodeURIComponent($json.query.redirect_uri || '') + '&state=' + encodeURIComponent($json.query.state || '') }}","options":{"responseCode":307}},"id":"a2f0c0d1-2222-4b22-8222-222222222222","name":"Redirect to TikTok","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[-240,-120]},{"parameters":{"httpMethod":"POST","path":"tiktok-oauth-token-proxy","responseMode":"responseNode","options":{}},"id":"a3f0c0d1-3333-4b33-8333-333333333333","name":"Token Proxy","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-520,180],"webhookId":"b3f0c0d1-3333-4b33-8333-333333333333"},{"parameters":{"mode":"runOnceForAllItems","jsCode":"const b=$json.body||{};\nconst params={client_key:b.client_id||b.client_key||'',client_secret:b.client_secret||'',grant_type:b.grant_type||''};\nif(b.code) params.code=b.code;\nif(b.redirect_uri) params.redirect_uri=b.redirect_uri;\nif(b.refresh_token) params.refresh_token=b.refresh_token;\nconst form=Object.entries(params).filter(([,v])=>String(v||'').length).map(([k,v])=>encodeURIComponent(k)+'='+encodeURIComponent(String(v))).join('&');\nreturn [{json:{form}}];"},"id":"a4f0c0d1-4444-4b44-8444-444444444444","name":"Translate OAuth Params","type":"n8n-nodes-base.code","typeVersion":2,"position":[-260,180]},{"parameters":{"method":"POST","url":"https://open.tiktokapis.com/v2/oauth/token/","sendBody":true,"contentType":"form-urlencoded